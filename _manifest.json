{
  "manifest_version": 2,
  "id": "github.qipi128-blip.wardrobe",
  "version": "2.0.0",
  "name": "她的衣橱",
  "description": "上传图片让模型知道自己穿什么；每天随机换一套；自己写特殊日子，当天就穿指定衣服。所有操作都在 MaiBot 首页的「她的衣橱」本地页面完成，不用在 QQ 里发指令。",
  "author": {
    "name": "Tyler",
    "url": "https://github.com/qipi128-blip"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/qipi128-blip/maibot-wardrobe",
    "homepage": "https://github.com/qipi128-blip/maibot-wardrobe",
    "documentation": "https://github.com/qipi128-blip/maibot-wardrobe/blob/main/README.md",
    "issues": "https://github.com/qipi128-blip/maibot-wardrobe/issues"
  },
  "host_application": {
    "min_version": "1.2.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.8.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "plugin_type": "extension",
  "changelog": "CHANGELOG.md",
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.svg",
      "fallback": "shirt",
      "background": "#9a3412"
    }
  },
  "capabilities": [
    "send.text",
    "llm.generate",
    "config.get"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
